sketchybar --bar position=top \
                 height=32 \
                 blur_radius=30 \
                 color=0x00000000 \
                 y_offset=-37

# sketchybar --default updates=when_shown

# position e starts at the notch's right edge, so items lay out left-to-right
# without the old padding_right overflow hack
sketchybar --add item workspace e \
           --set workspace update_freq=2 \
                          icon.drawing=off \
                          label.color=0xffffffff \
                          padding_left=10 \
                          script="$HOME/.config/sketchybar/plugins/workspace.sh" \
           --subscribe workspace space_change

# populate items immediately instead of waiting for the first update_freq tick
sketchybar --update
